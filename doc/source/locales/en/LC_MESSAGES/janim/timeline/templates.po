#: ../../source/janim/timeline/templates.rst:2
msgid "templates"
msgstr "templates"

#: janim.timeline.templates.SourceTimeline:1 of
msgid "与 :class:`Timeline` 相比，会在背景显示源代码"
msgstr "Compared to :class:`Timeline`, this will display the source code in the background."

#: janim.timeline.templates.SourceTimeline.build:1 of
msgid "构建动画并返回"
msgstr "Build the animation and return it"

#: janim.timeline.templates.ListedTimelines:1 of
msgid "指定一组 :class:`Timeline` 实现，将他们依次播放"
msgstr "Specify a group of :class:`Timeline` implementations and play them in sequence"

#: janim.timeline.templates.AboveTimelines:3 janim.timeline.templates.AboveTimelines:24
#: janim.timeline.templates.ListedTimelines:3 of
msgid "示例："
msgstr "Example:"

#: janim.timeline.templates.ListedTimelines:5 of
msgid ""
"class Section0(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section1(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section2(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Sections(ListedTimelines):\n"
"    includes = [Section1, Section2]"
msgstr ""
"class Section0(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section1(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section2(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Sections(ListedTimelines):\n"
"    includes = [Section1, Section2]"

#: janim.timeline.templates.AboveTimelines:1 of
msgid "依次播放在同文件中先前定义过的所有 :class:`Timeline` 实现"
msgstr "Play all :class:`Timeline` implementations previously defined in the same file, in order"

#: janim.timeline.templates.AboveTimelines:5 of
msgid ""
"class Section0(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section1(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section2(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Sections(AboveTimelines):\n"
"    pass"
msgstr ""
"class Section0(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section1(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Section2(Timeline):\n"
"    def construct(self):\n"
"        ...\n"
"\n"
"class Sections(AboveTimelines):\n"
"    pass"

#: janim.timeline.templates.AboveTimelines:22 of
msgid "可另外使用 ``excludes`` 指定排除项"
msgstr "You can additionally use ``excludes`` to specify excluded items"

#: janim.timeline.templates.AboveTimelines:26 of
msgid ""
"...\n"
"\n"
"class Sections(AboveTimelines):\n"
"    excludes = [Section0]"
msgstr ""
"...\n"
"\n"
"class Sections(AboveTimelines):\n"
"    excludes = [Section0]"
