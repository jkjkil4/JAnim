#: ../../source/janim/items/effect/effects.rst:2
msgid "effects"
msgstr "effects"

#: janim.items.effect.effects.AlphaEffect:1 of
msgid "透明度效果，使用 ``.alpha.set(...)`` 更新不透明度值"
msgstr "An opacity effect; use ``.alpha.set(...)`` to update the opacity value"

#: janim.items.effect.effects.AlphaEffect:3 of
msgid "示例："
msgstr "Example:"

#: janim.items.effect.effects.AlphaEffect:5 of
msgid ""
"circles = Circle(fill_alpha=1) * 4\n"
"circles.show()\n"
"circles.points.arrange_in_grid(buff=-0.4)\n"
"\n"
"effect = AlphaEffect(circles)\n"
"\n"
"self.play(\n"
"    effect.anim.alpha.set(0),\n"
"    effect.anim.alpha.set(1),\n"
"    lag_ratio=1,\n"
")"
msgstr ""
"circles = Circle(fill_alpha=1) * 4\n"
"circles.show()\n"
"circles.points.arrange_in_grid(buff=-0.4)\n"
"\n"
"effect = AlphaEffect(circles)\n"
"\n"
"self.play(\n"
"    effect.anim.alpha.set(0),\n"
"    effect.anim.alpha.set(1),\n"
"    lag_ratio=1,\n"
")"

#: janim.items.effect.effects.Shadertoy:1 of
msgid "一个用于创建类似 Shadertoy 着色器效果的类"
msgstr "A class for creating Shadertoy-like shader effects"

#: janim.items.effect.effects.Shadertoy:3 of
msgid "例:"
msgstr "Example:"

#: janim.items.effect.effects.Shadertoy:5 of
#, python-brace-format
msgid ""
"Shadertoy(\n"
"    '''\n"
"    void mainImage( out vec4 fragColor, in vec2 fragCoord ) {\n"
"        vec2 uv = fragCoord.xy / iResolution.xy;\n"
"        vec3 color = vec3(uv.x, uv.y, 0.5);\n"
"        fragColor = vec4(color, 1.0);\n"
"    }\n"
"    '''\n"
").show()"
msgstr ""
"Shadertoy(\n"
"    '''\n"
"    void mainImage( out vec4 fragColor, in vec2 fragCoord ) {\n"
"        vec2 uv = fragCoord.xy / iResolution.xy;\n"
"        vec3 color = vec3(uv.x, uv.y, 0.5);\n"
"        fragColor = vec4(color, 1.0);\n"
"    }\n"
"    '''\n"
").show()"

#: janim.items.effect.effects.Shadertoy:19 of
msgid "如果该着色器代码中出现报错，会显示为 ``JA_SHADERTOY`` 中出现的"
msgstr "If an error occurs in the shader code, it will be displayed as occurring in ``JA_SHADERTOY``."

#: janim.items.effect.effects.Shadertoy:21 of
msgid "可以使用 :meth:`anim_update` 创建 ``iTime`` uniform 更新的动画，例如："
msgstr "You can use :meth:`anim_update` to create an animation that updates the ``iTime`` uniform, for example:"

#: janim.items.effect.effects.Shadertoy:23 of
msgid ""
"# Originates from https://www.shadertoy.com/view/mtyGWy\n"
"shader = Shadertoy(\n"
"    \"\"\"\n"
"    /* This animation is the material of my first youtube tutorial about creative\n"
"    coding, which is a video in which I try to introduce programmers to GLSL\n"
"    and to the wonderful world of shaders, while also trying to share my recent\n"
"    passion for this community.\n"
"                                        Video URL: https://youtu.be/f4s1h2YETNY\n"
"    */\n"
"\n"
"    //https://iquilezles.org/articles/palettes/\n"
"    vec3 palette( float t ) {\n"
"        vec3 a = vec3(0.5, 0.5, 0.5);\n"
"        vec3 b = vec3(0.5, 0.5, 0.5);\n"
"        vec3 c = vec3(1.0, 1.0, 1.0);\n"
"        vec3 d = vec3(0.263,0.416,0.557);\n"
"\n"
"        return a + b*cos( 6.28318*(c*t+d) );\n"
"    }\n"
"\n"
"    //https://www.shadertoy.com/view/mtyGWy\n"
"    void mainImage( out vec4 fragColor, in vec2 fragCoord ) {\n"
"        vec2 uv = (fragCoord * 2.0 - iResolution.xy) / iResolution.y;\n"
"        vec2 uv0 = uv;\n"
"        vec3 finalColor = vec3(0.0);\n"
"\n"
"        for (float i = 0.0; i < 4.0; i++) {\n"
"            uv = fract(uv * 1.5) - 0.5;\n"
"\n"
"            float d = length(uv) * exp(-length(uv0));\n"
"\n"
"            vec3 col = palette(length(uv0) + i*.4 + iTime*.4);\n"
"\n"
"            d = sin(d*8. + iTime)/8.;\n"
"            d = abs(d);\n"
"\n"
"            d = pow(0.01 / d, 1.2);\n"
"\n"
"            finalColor += col * d;\n"
"        }\n"
"\n"
"        fragColor = vec4(finalColor, 1.0);\n"
"    }\n"
"    \"\"\"\n"
")\n"
"\n"
"self.play(\n"
"    shader.anim_update(duration=4),\n"
")"
msgstr ""
"# Originates from https://www.shadertoy.com/view/mtyGWy\n"
"shader = Shadertoy(\n"
"    \"\"\"\n"
"    /* This animation is the material of my first youtube tutorial about creative\n"
"    coding, which is a video in which I try to introduce programmers to GLSL\n"
"    and to the wonderful world of shaders, while also trying to share my recent\n"
"    passion for this community.\n"
"                                        Video URL: https://youtu.be/f4s1h2YETNY\n"
"    */\n"
"\n"
"    //https://iquilezles.org/articles/palettes/\n"
"    vec3 palette( float t ) {\n"
"        vec3 a = vec3(0.5, 0.5, 0.5);\n"
"        vec3 b = vec3(0.5, 0.5, 0.5);\n"
"        vec3 c = vec3(1.0, 1.0, 1.0);\n"
"        vec3 d = vec3(0.263,0.416,0.557);\n"
"\n"
"        return a + b*cos( 6.28318*(c*t+d) );\n"
"    }\n"
"\n"
"    //https://www.shadertoy.com/view/mtyGWy\n"
"    void mainImage( out vec4 fragColor, in vec2 fragCoord ) {\n"
"        vec2 uv = (fragCoord * 2.0 - iResolution.xy) / iResolution.y;\n"
"        vec2 uv0 = uv;\n"
"        vec3 finalColor = vec3(0.0);\n"
"\n"
"        for (float i = 0.0; i < 4.0; i++) {\n"
"            uv = fract(uv * 1.5) - 0.5;\n"
"\n"
"            float d = length(uv) * exp(-length(uv0));\n"
"\n"
"            vec3 col = palette(length(uv0) + i*.4 + iTime*.4);\n"
"\n"
"            d = sin(d*8. + iTime)/8.;\n"
"            d = abs(d);\n"
"\n"
"            d = pow(0.01 / d, 1.2);\n"
"\n"
"            finalColor += col * d;\n"
"        }\n"
"\n"
"        fragColor = vec4(finalColor, 1.0);\n"
"    }\n"
"    \"\"\"\n"
")\n"
"\n"
"self.play(\n"
"    shader.anim_update(duration=4),\n"
")"

#: janim.items.effect.effects.Shadertoy.anim_update:1 of
msgid "创建 ``iTime`` uniform 更新的动画"
msgstr "Creates an animation that updates the ``iTime`` uniform"

#: janim.items.effect.effects.Shadertoy.create_updater:1 of
msgid "同 :meth:`anim_update` ，此为旧名称"
msgstr "Same as :meth:`anim_update`; this is the old name"
