#: ../../source/janim/items/relation.rst:2
msgid "relation"
msgstr "relation"

#: janim.items.relation.ItemRelation:1 of
msgid "定义了物件的有向无环图的包含关系以及一些实用操作"
msgstr "Defines the containment relationships in the directed acyclic graph of items, along with some useful operations."

#: janim.items.relation.ItemRelation:3 of
msgid "该类仅作为 :class:`~.Item` 的基类，不作为直接创建使用"
msgstr "This class is intended only as a base class for :class:`~.Item` and is not meant to be instantiated directly."

#: janim.items.relation.ItemRelation.parents:1 of
msgid "父物件列表的一份拷贝"
msgstr "A copy of the parent-item list"

#: janim.items.relation.ItemRelation.children:1 of
msgid "子物件列表的一份拷贝"
msgstr "A copy of the child-item list"

#: janim.items.relation.ItemRelation.index:1 of
msgid "获取子物件在列表中的索引位置"
msgstr "Get the index of a child item in the list"

#: ../../source/janim/items/relation.rst
msgid "参数"
msgstr "Parameters"

#: janim.items.relation.ItemRelation.index:3 of
msgid "要查找的子物件"
msgstr "Child item to find"

#: ../../source/janim/items/relation.rst
msgid "返回"
msgstr "Returns"

#: janim.items.relation.ItemRelation.index:4 of
msgid "子物件的索引位置"
msgstr "Index of the child item"

#: ../../source/janim/items/relation.rst
msgid "抛出"
msgstr "Raises"

#: janim.items.relation.ItemRelation.index:5 of
msgid "子物件不在列表中"
msgstr "Child item not in the list"

#: janim.items.relation.ItemRelation.add:1 of
msgid "向该物件添加子物件"
msgstr "Add child items to this item"

#: janim.items.relation.ItemRelation.add:3 of
msgid "要添加的子物件"
msgstr "Child items to add"

#: janim.items.relation.ItemRelation.add:4 of
msgid "默认为 ``False``，如果为 ``True``，那么插入到子物件列表的开头"
msgstr "If `insert=True` (default is `False`), then insert at the beginning of the list of child items."

#: janim.items.relation.ItemRelation.insert:1 of
msgid "在指定索引位置插入子物件"
msgstr "Insert child items at the specified index"

#: janim.items.relation.ItemRelation.insert:3 of
msgid "插入位置的索引"
msgstr "Index at which to insert"

#: janim.items.relation.ItemRelation.insert:4 of
msgid "要插入的子物件"
msgstr "Child items to insert"

#: janim.items.relation.ItemRelation.remove:1 of
msgid "从该物件移除子物件"
msgstr "Remove child items from this item"

#: janim.items.relation.ItemRelation.remove:3 of
msgid "要移除的子物件"
msgstr "Child items to remove"

#: janim.items.relation.ItemRelation.shuffle:1 of
msgid "随机打乱子物件的顺序"
msgstr "Randomly shuffle the order of child items"

#: janim.items.relation.ItemRelation.shuffle:5 of
msgid "该方法使用 :func:`random.shuffle` 进行随机打乱"
msgstr "This method uses :func:`random.shuffle` to shuffle"

#: janim.items.relation.ItemRelation.shuffle:7 of
msgid "如果需要可重复的随机结果，请在调用此方法前使用 :func:`random.seed` 设置随机数种子"
msgstr "For reproducible randomness, set the seed with :func:`random.seed` before calling this method"

#: janim.items.relation.ItemRelation.clear_parents:1 of
msgid "清空父物件"
msgstr "Clear parent items"

#: janim.items.relation.ItemRelation.clear_children:1 of
msgid "清空子物件"
msgstr "Clear child items"

#: janim.items.relation.ItemRelation.ancestors:1 of
msgid "获得祖先物件列表"
msgstr "Get a list of ancestor items"

#: janim.items.relation.ItemRelation.ancestors:3 of
msgid "注：该方法会临时从 :meth:`walk_ancestors` 构造列表，对于遍历的需求，建议参考并使用 :meth:`walk_ancestors`"
msgstr ""
"Note: This method temporarily constructs a list from :meth:`walk_ancestors`. For traversal purposes, it is recommended to "
"use :meth:`walk_ancestors` instead."

#: janim.items.relation.ItemRelation.ancestors:5 janim.items.relation.ItemRelation.descendants:5
#: janim.items.relation.ItemRelation.walk_ancestors:4 janim.items.relation.ItemRelation.walk_descendants:4
#: janim.items.relation.ItemRelation.walk_self_and_ancestors:5 janim.items.relation.ItemRelation.walk_self_and_descendants:5
#: of
msgid "默认按照 DFS 顺序，若指定 ``unordered=True`` 则不保证顺序，对于复杂结构的性能会更佳"
msgstr ""
"By default, items are traversed in DFS order. If ``unordered=True`` is specified, the order is not guaranteed, but "
"performance may be better for complex structures."

#: janim.items.relation.ItemRelation.descendants:1 of
msgid "获得后代物件列表"
msgstr "Get a list of descendant items"

#: janim.items.relation.ItemRelation.descendants:3 of
msgid "注：该方法会临时从 :meth:`walk_descendants` 构造列表，对于遍历的需求，建议参考并使用 :meth:`walk_descendants`"
msgstr ""
"Note: This method temporarily constructs a list from :meth:`walk_descendants`. For traversal purposes, it is recommended "
"to use :meth:`walk_descendants` instead."

#: janim.items.relation.ItemRelation.walk_ancestors:1 of
msgid "遍历祖先节点中以 ``base_cls`` 为基类的物件"
msgstr "Traverse ancestor nodes for items that are instances of ``base_cls``"

#: janim.items.relation.ItemRelation.walk_ancestors:3 janim.items.relation.ItemRelation.walk_descendants:3
#: janim.items.relation.ItemRelation.walk_self_and_ancestors:4 janim.items.relation.ItemRelation.walk_self_and_descendants:4
#: of
msgid "用于检查的基类，若缺省则遍历全部"
msgstr "The base class to check against. If omitted, all items are traversed."

#: janim.items.relation.ItemRelation.walk_descendants:1 of
msgid "遍历后代节点中以 ``base_cls`` 为基类的物件"
msgstr "Traverse descendant nodes for items that are instances of ``base_cls``"

#: janim.items.relation.ItemRelation.walk_self_and_ancestors:1 janim.items.relation.ItemRelation.walk_self_and_descendants:1
#: of
msgid "遍历自己以及后代节点中以 ``base_cls`` 为基类的物件"
msgstr "Traverse the item itself and its descendant nodes for items that are instances of ``base_cls``"

#: janim.items.relation.ItemRelation.walk_self_and_ancestors:3 of
msgid "是否忽略所有祖先节点，仅考虑根节点"
msgstr "Whether to ignore all ancestor nodes and consider only the root nodes"

#: janim.items.relation.ItemRelation.walk_self_and_descendants:3 of
msgid "是否忽略所有后代节点，仅考虑根节点"
msgstr "Whether to ignore all descendant nodes and consider only the root nodes"

#: janim.items.relation.ItemRelation.walk_nearest_ancestors:1 of
msgid "遍历祖先节点中以 ``base_cls`` 为基类的物件，但是排除已经满足条件的物件的祖先物件"
msgstr ""
"Traverse ancestor nodes for items that are instances of ``base_cls``, excluding the ancestors of items that already "
"satisfy the condition"

#: janim.items.relation.ItemRelation.walk_nearest_descendants:1 of
msgid "遍历后代节点中以 ``base_cls`` 为基类的物件，但是排除已经满足条件的物件的后代物件"
msgstr ""
"Traverse descendant nodes for items that are instances of ``base_cls``, excluding the descendants of items that already "
"satisfy the condition"

