#: ../../source/janim/render/encoder.rst:2
msgid "encoder"
msgstr "encoder"

#: janim.render.encoder.PyavVideoEncoder:1 of
msgid "使用 PyAV 编码视频"
msgstr "Encode videos using PyAV"

#: janim.render.encoder.PyavVideoEncoder:3 of
msgid "不考虑硬件加速检测"
msgstr "Hardware acceleration detection is not considered"

#: janim.render.encoder.FFmpegH264VideoEncoder:1 of
msgid "使用 FFmpeg bin 编码 H.264 (.mp4) 视频"
msgstr "Encode H.264 (.mp4) videos using the FFmpeg binary"

#: janim.render.encoder.FFmpegH264VideoEncoder:3 of
msgid "考虑硬件加速检测"
msgstr "Hardware acceleration detection is considered"

#: janim.render.encoder.FFmpegH264VideoEncoder.find_encoder:1 of
msgid "查找编码器，优先使用硬件编码器"
msgstr "Find an encoder, preferring hardware encoders"

#: janim.render.encoder.FFmpegH264VideoEncoder.find_encoder_device:1 of
msgid "返回首个可用的 VA-API 渲染节点，若无则返回 ``None``"
msgstr "Return the first available VA-API render node, or ``None`` if unavailable"

#: janim.render.encoder.PyavAudioEncoder:1 of
msgid "使用 PyAV 编码音频"
msgstr "Encode audio using PyAV"

