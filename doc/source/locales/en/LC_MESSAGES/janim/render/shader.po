#: ../../source/janim/render/shader.rst:2
msgid "shader"
msgstr "shader"

#: janim.render.shader.resolve_shader_from_file:1 of
msgid "读取 ``file_path`` shader 文件，并解析其中的 “预编译宏”"
msgstr "Read the shader file at ``file_path`` and parse the \"preprocessor macros\" contained in it"

#: janim.render.shader.resolve_shader_from_file:3 janim.render.shader.resolve_shader_from_source:3 of
msgid "对于 ``#include \"xxx\"`` ，会读取对应的文件"
msgstr "For ``#include \"xxx\"``, the corresponding file will be read"

#: janim.render.shader.resolve_shader_from_file:5 janim.render.shader.resolve_shader_from_source:5 of
msgid "若某个文件存在重复包含的情况，则仅第一次有效，后续会直接忽略"
msgstr "If a file is included multiple times, only the first inclusion is effective and subsequent ones are ignored"

#: janim.render.shader.resolve_shader_from_file:7 janim.render.shader.resolve_shader_from_source:9 of
msgid "对于 ``#[xxx]`` ，会根据 :class:`ShaderInjection` 替换为对应的目标字符串"
msgstr "For ``#[xxx]``, it is replaced with the corresponding target string according to :class:`ShaderInjection`"

#: janim.render.shader.resolve_shader_from_file_or_none:1 of
msgid "和 :py:func:`resolve_shader_from_file` 一样，区别在于在找不到文件时返回 ``None``"
msgstr "Same as :py:func:`resolve_shader_from_file`, except that it returns ``None`` when the file cannot be found"

#: janim.render.shader.resolve_shader_from_source:1 of
msgid "处理 ``source`` 代码，解析其中的 “预编译宏”"
msgstr "Process the ``source`` code and parse the \"preprocessor macros\" contained in it"

#: janim.render.shader.resolve_shader_from_source:7 of
msgid "``dir_path`` 决定了其搜索基于的路径"
msgstr "``dir_path`` determines the base path used for searching"

#: janim.render.shader.convert_error_nameidx_to_name:1 of
msgid "将 ModernGL 报错信息中的 nameidx 转换为 name"
msgstr "Convert ``nameidx`` to ``name`` in ModernGL error messages"
